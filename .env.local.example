# Copy to .env.local for local runs, and set the same names in Vercel →
# Project → Settings → Environment Variables for the deployment.
#
# ZENTRAGRID_API_KEY is the project-wide key the Vega app already uses. It must
# stay on the server: every ZentraGrid call goes through this app's own
# /api/* routes, and the browser never sees the key.
ZENTRAGRID_API_KEY=

# The handle the panel announces itself with in the `presence` collection, so
# the phone app's chat header can show "Online now". Keep it lowercase; one
# handle is one presence document, so a shared `vega-team` is fine.
PANEL_HANDLE=vega-team
